# ─────────────────────────────────────────────────────────────────────────────
# infra/docker/.env  —  Docker Compose environment file
# Copy this to infra/docker/.env and fill in real values.
# NEVER commit the actual .env — only this .env.example
# ─────────────────────────────────────────────────────────────────────────────

# ── Compose project name (avoids conflicts between projects) ──────────────────
COMPOSE_PROJECT_NAME=enterprise-workflow

# ── MongoDB credentials (production only) ─────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me-in-production

# ── Frontend public API URL baked into the Next.js build ──────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api
