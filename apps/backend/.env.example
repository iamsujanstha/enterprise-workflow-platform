# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/auth
MONGO_DB_NAME=auth

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ── min 32 chars in production; use AWS Secrets Manager ────────────────
JWT_SECRET=change-me-to-a-random-256-bit-secret-string-here
JWT_SECRET_PREV=                      # previous key — populated during rotation
JWT_KID=v1                            # key version embedded in JWT header

# ── Session HMAC ── used to hash refresh tokens stored in Redis ───────────────
REDIS_HMAC_SECRET=change-me-to-a-different-256-bit-secret-here

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
APP_FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001

# ── AWS (production only) ─────────────────────────────────────────────────────
AWS_REGION=us-east-1
JWT_SECRET_NAME=/prod/auth/jwt-secret   # Secrets Manager path
KMS_TOTP_KEY_ID=                        # KMS key for TOTP secret encryption
SES_FROM_EMAIL=noreply@example.com
